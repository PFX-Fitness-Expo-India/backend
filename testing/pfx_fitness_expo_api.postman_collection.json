				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.environment.set(\"jwtToken\", jsonData.data.token);",
									"}",
									"if (jsonData.data && jsonData.data.refreshToken) {",
									"    pm.environment.set(\"refreshToken\", jsonData.data.refreshToken);",
									"}",
									"if (jsonData.data && jsonData.data.userId) {",
									"    pm.environment.set(\"userId\", jsonData.data.userId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"credentials\": \"john@example.com\",\n    \"password\": \"Password123\"\n}",
